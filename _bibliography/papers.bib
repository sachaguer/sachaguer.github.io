@article{2024PhRvD.109b3533G,
 abbr = {Phys. Rev. D},
 abstract = {{Observations of galaxy-scale strong gravitational lensing systems enable
unique tests of departures from general relativity at the kilo-
to megaparsec scale. In this work, the gravitational slip
parameter {\ensuremath{\gamma}}$_{PN}$, measuring the amplitude
of a hypothetical fifth force, is constrained using 130
elliptical galaxy lens systems. We implement a lens model with a
power-law total mass density and a deprojected De Vaucouleurs
luminosity density, favored over a power-law luminosity density.
To break the degeneracy between the lens velocity anisotropy
{\ensuremath{\beta}} and the gravitational slip, we introduce a
new prior on the velocity anisotropy based on recent dynamical
data. For a constant gravitational slip, we find
{\ensuremath{\gamma}}$_{PN}$=0.9 0$_{-0.14}$$^{+0.18}$ in
agreement with general relativity at the 68\% confidence level.
Introducing a Compton wavelength {\ensuremath{\lambda}}$_{g}$,
effectively screening the fifth force at small and large scales,
the best fit is obtained for
{\ensuremath{\lambda}}$_{g}${\ensuremath{\sim}}0.2 Mpc and
{\ensuremath{\gamma}}$_{PN}$=0.7 7$_{-0.14}$$^{+0.25}$. A local
minimum is found at
{\ensuremath{\lambda}}$_{g}${\ensuremath{\sim}}100 Mpc and
{\ensuremath{\gamma}}$_{PN}$=0.5 6$_{-0.35}$$^{0.45}$. We
conclude that there is no evidence in the data for a significant
departure from general relativity and that using accurate
assumptions and having good constraints on the lens galaxy model
is key to ensure reliable constraints on the gravitational slip.}},
 adsnote = {Provided by the SAO/NASA Astrophysics Data System},
 adsurl = {https://ui.adsabs.harvard.edu/abs/2024PhRvD.109b3533G},
 archiveprefix = {arXiv},
 arxiv = {2309.11915},
 author = {{Guerrini}, Sacha and {M{\"o}rtsell}, Edvard},
 bibtex_show = {true},
 doi = {10.1103/PhysRevD.109.023533},
 eid = {023533},
 eprint = {2309.11915},
 journal = {Physical Review D},
 keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics, General Relativity and Quantum Cosmology},
 month = {January},
 number = {2},
 pages = {023533},
 primaryclass = {astro-ph.CO},
 selected = {true},
 title = {{Probing a scale dependent gravitational slip with galaxy strong lensing systems}},
 volume = {109},
 year = {2024}
}
